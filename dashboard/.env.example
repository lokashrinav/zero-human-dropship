# All URLs and tokens are read server-side unless prefixed NEXT_PUBLIC_.
DASHBOARD_REQUEST_TIMEOUT_MS=4000

# Stripe: use the attested revenue endpoint (preferred) OR a live secret/restricted key.
STRIPE_REVENUE_URL=
STRIPE_REVENUE_TOKEN=
STRIPE_SECRET_KEY=

# Linq: LINQ_BASE_URL expands to /api/status and /api/events. Explicit URLs override it.
LINQ_BASE_URL=
LINQ_STATUS_URL=
LINQ_EVENTS_URL=
LINQ_API_TOKEN=

# Person A / Terac inputs. CATALOG_URL overrides the verified storefront default.
CEO_DECISIONS_URL=
CEO_DECISIONS_TOKEN=
TERAC_FEEDBACK_URL=
TERAC_FEEDBACK_TOKEN=
CATALOG_URL=https://storefront-omega-three.vercel.app/api/catalog
CATALOG_TOKEN=
CATALOG_JSON_PATH=

# Sponsor proof endpoints. Band is intentionally disabled and is not probed.
BAND_STATUS_URL=
BAND_STATUS_TOKEN=
RENDER_STATUS_URL=
RENDER_STATUS_TOKEN=
REPLAY_VERIFICATION_URL=
REPLAY_VERIFICATION_TOKEN=
